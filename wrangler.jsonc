{
  "name": "freeparking",
  "main": "edge/anti-scraping.mjs",
  "compatibility_date": "2026-11-23",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "SITE_RATE_LIMIT",
      "namespace_id": "20261123",
      "simple": { "limit": 180, "period": 60 }
    }
  ]
}
